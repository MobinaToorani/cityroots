# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty for local development: an embedded Postgres (PGlite)
# is created in .data/pglite. Set it to a Neon or Supabase URL for deploys.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# --- Auth (Auth.js) -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Optional: Google sign-in. Set both or neither.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional in development: without it, magic links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="CityRoots <hello@cityroots.ca>"

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Moderation -----------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Payments (Stripe) ----------------------------------------------------
# Optional in development. Set both or neither. Create the Pro prices once
# with: npx tsx scripts/stripe-setup.ts (test mode keys only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin ----------------------------------------------------------------
# Comma-separated emails that always get the admin role. Use it to create the
# first admin; promote curators with: npx tsx scripts/set-role.ts <email> curator
ADMIN_EMAILS=

# --- Feature flags (launch scope) ------------------------------------------
FEATURE_PARTNERS=false
FEATURE_BUSINESS=false
EMAIL_LOG_ONLY=
