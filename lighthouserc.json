{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/city/newmarket",
        "http://localhost:3200/about",
        "http://localhost:3200/explore?city=waterloo",
        "http://localhost:3200/events",
        "http://localhost:3200/submit",
        "http://localhost:3200/pricing",
        "http://localhost:3200/planner",
        "http://localhost:3200/partners",
        "http://localhost:3200/business",
        "http://localhost:3200/guides",
        "http://localhost:3200/guides/rainy-sunday-waterloo"
      ],
      "numberOfRuns": 3,
      "settings": {
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 9000,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://localhost:3200/(city/.*|about|events.*|submit|pricing|planner|partners|business|guides.*)?$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 184320
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3200/explore.*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
